# ============================================================================
# ASTROHEALTH — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `backend/.env` and customize if connecting to MySQL
# or an optional server-side AI provider.
# Do NOT commit real credentials or API keys to version control.
# ============================================================================

# Application Metadata
APP_NAME=AstroHealth API
APP_VERSION=1.2.0
ENVIRONMENT=development

# Database Configuration
# Options: "sqlite" (default zero-config local database) or "mysql"
DB_ENGINE=sqlite

# MySQL Connection Settings (Used when DB_ENGINE=mysql)
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password_placeholder
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=astrohealth

# Optional Full SQLAlchemy Database URL Override
# DATABASE_URL=mysql+pymysql://your_mysql_username:your_mysql_password@127.0.0.1:3306/astrohealth

# NASA Open Science Data Repository (OSDR) & Open APIs
NASA_OSDR_BASE_URL=https://osdr.nasa.gov/osdr/data
NASA_API_KEY=DEMO_KEY
NASA_TIMEOUT_SECONDS=6.0

# AI Health Assistant Server-Side Configuration
# Default is "rule_based" (transparent local analytical engine).
# Never expose API keys in frontend code.
AI_PROVIDER=rule_based
ASTROHEALTH_AI_API_KEY=
