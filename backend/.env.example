# ============================================================================
# ASTROHEALTH BACKEND — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env` inside `backend/` to customize database or API keys.
# ============================================================================

APP_NAME=AstroHealth API
APP_VERSION=1.2.0
ENVIRONMENT=development

# Database Engine: "sqlite" (default automatic local store) or "mysql"
DB_ENGINE=sqlite
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password_placeholder
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=astrohealth

# NASA Open Science Data Repository (OSDR)
NASA_OSDR_BASE_URL=https://osdr.nasa.gov/osdr/data
NASA_API_KEY=DEMO_KEY
NASA_TIMEOUT_SECONDS=6.0

# Optional Server-Side AI Provider
AI_PROVIDER=rule_based
ASTROHEALTH_AI_API_KEY=
